+
+void LimoDriver::commandWatchdogCallback()
+{
+    const auto now = std::chrono::steady_clock::now();
+    const double age = std::chrono::duration<double>(now - last_command_time_).count();
+    if (!command_received_ || age >= cmd_vel_timeout_) {
+        // Repeat the zero frame while stale so loss of the DREAM gate cannot
+        // leave the last nonzero serial command active in the base.
+        sendStopCommand();
+        if (!command_watchdog_stopped_) {
+            RCLCPP_WARN(
+                this->get_logger(),
+                "cmd_vel stale for %.3f s (limit %.3f s); serial output forced to zero",
+                age, cmd_vel_timeout_);
+            command_watchdog_stopped_ = true;
+        }
+    }
+}
